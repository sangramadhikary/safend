# ── Secrets & VPS access — must never be uploaded to Vercel build ──
# NOTE: Creating this file makes Vercel STOP reading .gitignore for uploads,
# so every sensitive path must be listed here explicitly.
VPS_SSH_ACCESS/
_vps_scripts/
cloud.env
*.dump
*.pem
*_ed25519
*_ed25519.pub

# Environment files
.env
.env.local
.env.*.local

# Local/build artifacts (not needed for deploy)
.next/
node_modules/
server/node_modules/
supabase/.temp/
*.log
.DS_Store

# GST return files from the portal (client GSTINs) — never upload
*_GSTR1_*.json
*_GSTR3B_*.json
*_GSTR2B_*.json
