# ============================================================
# Safend Ecosystem — Environment Variables Reference
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Domain & Subdomain Routing ────────────────────────────────
# Root domain used by middleware for subdomain detection.
# Subdomains: office.safend.in, client.safend.in, ops.safend.in
NEXT_PUBLIC_ROOT_DOMAIN=safend.in

# ── Supabase ─────────────────────────────────────────────────
# Project URL — safe to expose (used in browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/Public key — safe to expose (enforces RLS on all requests)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role key — NEVER expose to the browser.
# Used ONLY in server-side API routes (create-user, verify-employee).
# Rotate immediately if accidentally committed to version control.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Cloudflare R2 (DEPRECATED — now using Supabase Storage) ──
# These are no longer needed. File storage uses Supabase Storage
# on the self-hosted VPS (api.safend.in). Kept for reference only.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# NEXT_PUBLIC_R2_PUBLIC_URL=

# ── Firebase (DEPRECATED — fully migrated to Supabase) ───────
# Firebase is no longer used. All data (audit logs, leads, followups,
# quotations, work orders, agreements, rota, HR, operations) now lives
# in Supabase Postgres. Auth was already on Supabase. These can be removed.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Express PDF Server ────────────────────────────────────────
# The /server directory runs a separate Express process for PDF generation.
# In production, run it with: node server/index.js
# Set PORT if you need a non-default port (default: 3001).
PORT=3001

# Optional: CORS allowed origin for the PDF server (defaults to Next.js dev server)
SERVER_ALLOWED_ORIGIN=http://localhost:3000

# ── Resend (Email) ────────────────────────────────────────────
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# From address — must use a verified domain (update.safends.com)
RESEND_FROM_EMAIL=Safend <noreply@update.safends.com>

# Verified domain
RESEND_DOMAIN=update.safends.com

# WhatsApp OTP 2FA — Fast2SMS approved template ID for login OTP
# Template: "otp" — BODY: "OTP Code: {{1}}. This is your OTP code for {{2}}."
# {{1}} = 6-digit OTP, {{2}} = purpose label (e.g. "Login")
FAST2SMS_WHATSAPP_OTP_TEMPLATE_ID=1043655142001486

# Where website contact-form enquiry notifications are sent (defaults to admin@safends.com)
ENQUIRY_NOTIFY_EMAIL=admin@safends.com

# ── Vercel Cron (Attendance Maintenance Jobs) ────────────────
# Shared secret used to authenticate the Vercel Cron scheduler when it invokes
# the attendance maintenance routes:
#   GET /api/attendance/maintenance/expire     (daily at 03:00 — see vercel.json)
#   GET /api/attendance/maintenance/retention  (daily at 04:00 — see vercel.json)
# Vercel sends this value as `Authorization: Bearer <CRON_SECRET>`. The routes
# reject any caller lacking the exact token with 401 and fail closed when the
# secret is unset, so they are NEVER open to unauthenticated callers.
# Set this in the Vercel project env (Production + Preview). NEVER commit the
# real value. Generate a strong random value, e.g. `openssl rand -hex 32`.
#
# NOTE: On the Vercel Hobby plan cron runs at most once per day and its timing
# is only guaranteed within the scheduled hour, so no downstream logic may
# depend on the precise execution time — the jobs are idempotent and batched.
CRON_SECRET=your-strong-random-cron-secret

# ── Cloudflare Turnstile (Contact Form Anti-Bot) ──────────────
# Get keys from: https://dash.cloudflare.com → Turnstile → Add Widget
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x_your_site_key
TURNSTILE_SECRET_KEY=0x_your_secret_key

# ── Traccar GPS Server ────────────────────────────────────────
# Traccar URL — self-hosted GPS tracking server
TRACCAR_URL=https://track.safend.in

# Traccar Basic Auth — Base64 of "email:password" (e.g. `echo -n 'admin@example.com:password' | base64`)
TRACCAR_AUTH=your_base64_encoded_credentials_here

# ── Optional Integrations ─────────────────────────────────────
# Mappls (DigiPIN / map integration) — optional
NEXT_PUBLIC_MAPPLS_REST_KEY=your-mappls-rest-key
NEXT_PUBLIC_MAPPLS_MAP_KEY=your-mappls-map-key

# ── WebAuthn (Biometric/Fingerprint Login) ────────────────────
# Relying Party ID — your domain (without https:// or www.)
WEBAUTHN_RP_ID=safend.in
# Relying Party Name — displayed to user during registration
WEBAUTHN_RP_NAME=Safend

# Google Maps — alternative to Mappls
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-key

# Backend URL — if running a separate backend service
NEXT_PUBLIC_BACKEND_URL=https://your-backend-url.com
NEXT_PUBLIC_BACKEND_SECRET=your-backend-secret
# ── Server Cache / Redis (optional L2) ───────────────────────
# Server-only Redis connection string. Never prefix with NEXT_PUBLIC_.
# When unset or unavailable, requests safely fall back to Supabase.
# Example: redis://default:strong-password@redis.internal:6379
REDIS_URL=

# Cache isolation and safety limits. Defaults shown below.
CACHE_NAMESPACE=safend:v1
CACHE_L1_MAX_ENTRIES=250
CACHE_MAX_PAYLOAD_BYTES=1000000
CACHE_REDIS_CONNECT_TIMEOUT_MS=1500
CACHE_REDIS_COMMAND_TIMEOUT_MS=500

# ── Fast2SMS WhatsApp (WABA) ──────────────────────────────────────────────────
# API key from https://www.fast2sms.com/dashboard/dev-api
# Server-only. NEVER prefix with NEXT_PUBLIC_.
FAST2SMS_API_KEY=your-fast2sms-api-key

# WABA Phone Number ID from Fast2SMS WhatsApp Manager.
# Discover it via: GET https://safend.in/api/whatsapp/waba?type=number  (staff auth required)
FAST2SMS_PHONE_NUMBER_ID=your-waba-phone-number-id

# WABA Account ID — needed for template listing (Get All Templates, Get Template By Name).
# Same source: GET https://safend.in/api/whatsapp/waba?type=number → look for "waba_id" in response.
FAST2SMS_WABA_ID=your-waba-account-id

# WhatsApp API version (optional — defaults to v24.0)
FAST2SMS_API_VERSION=v24.0

# Shared secret to validate incoming webhook POST requests from Fast2SMS.
# Append as ?secret=<value> in the webhook URL when registering in Fast2SMS Dashboard.
# Generate with: openssl rand -hex 32
FAST2SMS_WEBHOOK_SECRET=your-webhook-secret-here
